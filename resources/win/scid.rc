
#include "windows.h"
/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
SCID                    ICON                    "scid.ico"


/////////////////////////////////////////////////////////////////////////////
//
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 5,1,1,0
 PRODUCTVERSION 5,1,1,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "04090000"
        BEGIN
            VALUE "CompanyName", "https://github.com/whelanh/scidCommunity"
            VALUE "FileDescription", "ScidCommunity Chess Database"
            VALUE "FileVersion", "5.1.1.0"
            VALUE "LegalCopyright", "Copyright (C) 1999-2025"
            VALUE "OriginalFilename", "scidCommunity.exe"
            VALUE "ProductName", "ScidCommunity"
            VALUE "ProductVersion", "5.1.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0
    END
END
/////////////////////////////////////////////////////////////////////////////

