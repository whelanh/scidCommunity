set helpTitle(U,PGNLichess) "lichess.org -painike"
set helpText(U,PGNLichess) {<h1>PGN-ikkuna: lichess.org-painike </h1>
  <p>
  <b>lichess.org</b> -painike <a PGN>PGN</a> -ikkunassa lataa nykyisen
  peli Lichess.org-sivustolle, jossa voit analysoida sitä tehokkailla tietokonemoottoreilla,
  jaa se muiden kanssa tai tuo se Lichess-tilillesi.
  </p>
  
  <h3> Kuinka käyttää </h3>
  <p>
  Napsauta <b>lichess.org</b> -painiketta katsellessasi mitä tahansa peliä. scidCommunity tulee:
  <ul>
  <li>Vie nykyinen peli <a PGN>PGN</a>-muodossa</li>
  <li> Lataa peli Lichessiin niiden tuontisovellusliittymän kautta </li>
  <li>Avaa pelin URL-osoite oletusselaimessasi </li>
  <li>Näytä peli Lichessin analyysiliittymässä </li>
  </ul>
  </p>
  
  <h3>Lichess-analyysiominaisuudet </h3>
  <p>
  Kun olet ladannut Lichessiin, voit:
  <ul>
  <li> Analysoi Stockfishin avulla (yksi maailman vahvimmista shakkimoottoreista) </li>
  <li> Saat välittömät tietokonearviot jokaisesta sijainnista </li>
  <li>Pyydä täydellinen pelianalyysi liikkeeltä liikkeeltä kommenteilla</li>
  <li>Tutustu avausteoriaan ja tietokantoihin </li>
  <li> Harjoittele asentoja tietokonetta vasten </li>
  <li>Jaa peli pysyvällä Lichess-URL-osoitteella </li>
  <li>Tuo peli Lichess-tilillesi (jos olet kirjautunut sisään)</li>
  </ul>
  </p>
  
  <h3>Pelitiedot mukana </h3>
  <p>
  Ladattu peli sisältää:
  <ul>
  <li> Kaikki liikkeet ja muunnelmat </li>
  <li>Kommentit ja huomautukset </li>
  <li> Pelin metatiedot (pelaajat, arvosanat, päivämäärä, tapahtuma jne.) </li>
  <li> Avaustiedot </li>
  </ul>
  </p>
  
  <h3> Jakaminen ja yksityisyys </h3>
  <p>
  Lichessiin ladatut pelit saavat ainutlaatuisen URL-osoitteen, jonka voit jakaa muiden kanssa.
  Pelit ovat oletuksena julkisesti saatavilla. Jos haluat pitää pelin yksityisenä,
  voit tuoda sen Lichess-tilillesi latauksen jälkeen ja asettaa sen yksityiseksi
  Lichess-asetuksesi.
  </p>
  
  <h3> Vaatimukset </h3>
  <p>
  Tämä ominaisuus vaatii:
  <ul>
  <li> Internet-yhteys </li>
  <li>curl (suositus) tai Tcl http-paketti </li>
  <li> Verkkoselain </li>
  </ul>
  Pelien lataamiseen ja analysointiin ei tarvita Lichess-tiliä, vaikka sillä on
  tili tarjoaa lisäominaisuuksia.
  </p>
  
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,PGNChessDB) "chessdb moottorin puupainike"
set helpText(U,PGNChessDB) {<h1>PGN-ikkuna: chessdb Engine Tree Button </h1>
  <p>
  <b>chessdb Engine Tree</b> -painike <a PGN>PGN</a> -ikkunassa avaa
  nykyinen asema ChessDB.cn:ssä, massiivisessa pilvipohjaisessa shakkitietokannassa
  miljardeja analysoituja kantoja ja tietokonearvioita.
  </p>
  
  <h3> Mikä on ChessDB.cn? </h3>
  <p>
  ChessDB.cn on ilmainen online-shakkitietokanta, joka tarjoaa:
  <ul>
  <li> Pilvipohjainen tietokoneanalyysi mille tahansa sijainnille </li>
  <li> Miljardeja esianalysoituja paikkoja peleistä ja moottorianalyysistä </li>
  <li>Useita moottoriarvioita ja parhaita liikeehdotuksia </li>
  <li> Avaustilastot ja teoria </li>
  <li> Endgame tablebase -integraatio </li>
  </ul>
  </p>
  
  <h3> Kuinka käyttää </h3>
  <p>
  Napsauta <b>chessdb Engine Tree</b> -painiketta tarkastellessasi mitä tahansa sijaintia.
  scidCommunity tulee:
  <ul>
  <li> Hanki nykyisen sijainnin FEN (Forsyth-Edwards Notation) </li>
  <li>Avaa ChessDB.cn oletusselaimessasi </li>
  <li> Lataa sijainti automaattisesti ChessDB-liittymään </li>
  <li>Näytä käytettävissä olevat analyysit ja tilastot kyseisestä sijainnista</li>
  </ul>
  </p>
  
  <h3> Mitä näet ChessDB:ssä</h3>
  <p>
  ChessDB.cn näyttää jokaisesta asemasta:
  <ul>
  <li><b>Moottoreiden arvioinnit </b>: Tietokoneanalyysi useista moottoreista </li>
  <li><b>Parhaat liikkeet </b>: Suositellut liikkeet arvioinneilla </li>
  <li><b> Pelitilastot</b>: Kuinka usein kukin liike on pelattu ja tulokset </li>
  <li><b> Avausnimet </b>: Jos asema on osa tunnettua avausteoriaa </li>
  <li><b>Historialliset pelit </b>: Pelit tietokannasta, jotka saavuttivat tämän aseman </li>
  <li><b> Taulukkopohjatulokset </b>: Täydellinen loppupelianalyysi sijoille, joissa on vähän nappuloita </li>
  </ul>
  </p>
  
  <h3>Käyttökotelot </h3>
  <p>
  ChessDB-painike on erityisen hyödyllinen:
  <ul>
  <li> Tarkistaa, onko sijainti analysoitu aiemmin </li>
  <li>Tietokoneen suositellun liikkeen löytäminen </li>
  <li> Avausteorian ja tilastojen tutkiminen </li>
  <li> Loppupelipaikkojen tarkistaminen </li>
  <li> Vaihtoehtoisten liikkeiden ja niiden arvioiden tutkiminen </li>
  </ul>
  </p>
  
  <h3> Vaatimukset </h3>
  <p>
  Tämä ominaisuus vaatii:
  <ul>
  <li>Internet-yhteys </li>
  <li> Verkkoselain </li>
  </ul>
  ChessDB.cn:n käyttäminen ei vaadi tiliä tai rekisteröintiä.
  </p>
  
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,PGNAutoComment) "Automaattinen kommenttipainike"
set helpText(U,PGNAutoComment) {<h1>PGN-ikkuna: Automaattinen kommenttipainike </h1>
  <p>
  <b>Automaattinen kommentti</b> -painike <a PGN>PGN</a> -ikkunassa käyttää tekoälyä
