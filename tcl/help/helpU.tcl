set helpTitle(U,Book) "Kirja-ikkuna"
set helpText(U,Book) {<h1>Kirjaikkuna </h1>
  <p>
  Luettelo kaikista scidCommunityn kirjahakemistossa olevista kirjatiedostoista on
  esitetään ikkunan yläosassa olevassa pudotusvalikossa. Määrittääksesi
  hakemisto, josta scidCommunityn pitäisi etsiä avattavia kirjoja, valitse Valinnat /
  Kirjahakemisto valikosta. Aktiivisen kirjan voi valita
  helposti tuolta listalta.
  </p>
  <p>
  Kirjojen muoto on Polyglotin käyttämä muoto, niiden tavallinen pääte on .bin.
  uusia kirjoja on käytettävä <term>polyglot</term> komentorivillä.
  Katso polyglottien dokumentaatio kirjan luomisesta.
  </p>
  <p>
  Kirja-ikkuna näyttää jokaisen sijainnin kaikki mahdolliset sen siirrot
  sisältää ja niiden suhteelliset painot prosentteina. Kun liike on
  kirja-ikkuna päivitetään. Napsauttamalla kirjan liikettä
  ikkuna toistaa sen liikkeen nykyisessä paikassa.
  </p>
  <p>
  Kirjaikkunan alaosassa oleva painike <i>Muut liikkeet </i> näyttää liikkeet
  joita ei ole kirjassa, vaan osa riveistä, jotka ovat myöhemmin kirjassa.
  Tämä antaa moottorille mahdollisuuden pelata parhaat liikkeet ja saada kirjavastauksia saatavilla 
  kirja, jos vastustaja valitsee liikkeet, jotka eivät ole kirjassa. Näiden <i>Muiden liikkeiden näyttö </i>
  näyttää, missä kirjassa on reikiä.
  </p>
  <p>
  Käytössä oleva kirja voidaan valita avattavasta luettelosta
  kirja-ikkuna.
  </p>
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,TacticalGame) "Taktinen peli-ikkuna"
set helpText(U,TacticalGame) {<h1>Taktinen peliikkuna </h1>
  <p>
  Pelaa taktista peliä moottoria vastaan, joka simuloi vastustajaa a
  antanut Elo-luokituksen.  Vastustajaa pelaavat Phalanx ja valmentaja
  millä tahansa käyttäjän määrittämillä UCI-moottorilla. Oikeat moottorit valitaan automaattisesti niiden mukaan
  nimet, ja ne tulee määrittää oikein (tämä on oletusarvo, kun
  scidCommunity on asennettu).
  </p>
  <p>
  <b>Huomaa</b>, että Phalanx-moottorin erikoisversio on
  vaaditaan. Tämä erikoisversio tulee scidCommunity-paketin mukana.
  </p>
  <p>
  Seuraavat parametrit on määritettävä:
  <ul>
  <li><term> Kiinteä taso </term>: asettaa vastustajalle kiinteän Elo-luokituksen </li>
  <li><term>Satunnainen taso </term>: valitsee satunnaisen tason
  vasemmalla ja oikealla liukusäätimellä määritetty vähimmäis- ja enimmäistaso
  vastaavasti.
  </li>
  <li><term>Avaaminen:</term>
  <ul>
     <li><term> Aloita uusi peli </term>: aloittaa uuden pelin valitsemalla
     satunnainen avautuminen. </li>
     <li><term> Aloita nykyisestä paikasta </term>: anna pelin alkaa
     nykyisen hallituksen sijainnin kanssa. </li>
     <li><term> Erityinen avaus </term>: vastustaja pelaa
     tietty aukko, joka voidaan valita alla olevasta luettelosta. Tämä on
     hyödyllinen aloitusharjoittelussa.</li>
  </ul>
  <li><term> Rajoita moottorin analyysiaikaa </term> sallii rajoittaa laitteen käyttämää aikaa.
  valmentaja tarkistaa pelaajien liikkeet virheiden varalta. Jos tällä kertaa ei ole
  rajoitettu valmentaja saa ajatella taustalla.</li>
  </ul>
  <p>Vinkki: Jos kytket <a Graphs>pistekaavion </a> päälle, näet ajankäytön ja paikan luokituksen pelin aikana.</p>
  <p> Aloita taktinen peli painamalla <term>Play</term></p> 

  <p><b>Huom</b> samanlainen toiminto voidaan saavuttaa pelaamalla
  <a SeriousGame> vakava peli </a> mitä tahansa UCI-moottoria vastaan, joka sen sallii
  sen voiman rajoittamiseksi.
  </p>
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,OpeningTrainer) "Kouluttajan avaus"
set helpText(U,OpeningTrainer) {<h1> Avausharjoitus </h1>
  <p>
  Repertuaarina voidaan käyttää scidCommunity-tietokantaa, jossa jokainen peli edustaa
  avauslinja. Pelit voivat sisältää muunnelmia ja voivat myös
  sisältää NAG-arvot määrittääksesi arvot kullekin riville ja siten
  mahdollistaa haluttujen tai kyseenalaisten rivien merkitsemisen. Ollakseen kelvollinen tietokanta
  avausharjoittelijalle sen on myös oltava oikeaa tyyppiä.
  Toisin sanoen, jos valkeaaukot halutaan kouluttaa, tietokanta on
  olla tyyppiä <term> Aukot valkoiselle </term> (samanlainen mustalle ja
  molemmat värit). Tyyppi voidaan asettaa <a Maintenance>Maintenancen kautta
  ikkuna </a> valitsemalla kuvake tai tietokannan vaihtajien kautta
  kontekstivalikko.
  </p>
  <p>
  <h2>Repertuaariperustan luominen </h2>
  Ennen kuin käytät avauskoulutusta, ota huomioon, että koko
  ohjelmistotietokanta ladataan kouluttajaan. tätä varten
  Tästä syystä on hyvä käyttää pienempää tietokantaa. Se on hyvä idea
  kokoa ensin suuri tietokanta laadukkaista peleistä ja suodata sitten
  tietokanta tietylle avaukselle (esim. Ruy Lopez). Nämä suodatettiin
  Pelit voitaisiin sitten kopioida uuteen tietokantaan kyseistä kohtaa varten
  avaaminen, jota pidit mielessäsi (nimeä se älykkäästi, jotta voit
  ymmärtää helposti, mihin aukkoon se on tarkoitettu). Sitten sen sijaan
  noin 2 miljoonan pelin tietokanta, sinulla on paljon pienempi tietokanta
  ohjelmistotietokanta, joka latautuu nopeasti aukkoon
  kouluttaja.
  </p>
  <p>
  Voit myös ostaa tai ladata erityisiä tietokantoja, jotka kattavat
  tiettyjä aukkoja, vaikka emme voi osoittaa sinua suuntaan
  tämän ohjetiedoston mahdollisista lähteistä.
  </p>
  <p>
  Kun sinulla on pienempi tietokanta, jonka tarkoituksena on vain avata sinua
  vaativat, aseta tyyppi mainitulla tavalla käyttämällä <a
  Maintenance>Maintenance-ikkunaa </a>.  Sinun on käynnistettävä scidCommunity uudelleen
  käyttää avauskouluttajaa tämän uuden ohjelmistotietokannan kanssa.
  </p>
  <p>
  Voit halutessasi ilmoittaa, jotta avauskouluttaja toimisi paremmin
  tiettyjä pelejä kuten "Valkoinen avaus" tai "Musta avaus". Kattava
  tapa tehdä tämä olisi käydä läpi koko tietokanta 'by
  käsi" ja määritä liput yksitellen. Nopeampi tapa voi olla
  suodata tietokantaasi valkoisten aukkojen varalta ja aseta sitten lippu kaikille
  ne suodatetut pelit ja vastaavasti mustille avauksille. Muista sinua
  voi olla repertuaari sekä valkoiselle että mustalle samassa tietokannassa.
  Voit asettaa liput tällä tavalla <a Maintenance>Maintenancen kautta
  ikkuna </a>. Päätät suodattaa pelit ilmoittamista varten
  täysin käyttäjästä kiinni. Yksi mahdollinen tapa on suodattaa 1-0 pelit
  valkoiset aukot ja 0-1 mustat aukot. Tämä tapa ei ole paras
  Käyttäjä voi kuitenkin löytää itselleen sopivan järjestelmän
  mukavin kanssa.
  </p>
  <p>
  Lopuksi, toimiakseen parhaiten, Opening Trainer voi käyttää NAG-arvoja ymmärtääkseen 
  miten avauksen liike on arvioitava. Katso <a NAGs>NAG 
  annotation help </a> saadaksesi lisätietoja.
  </p>
  <p>
  <h2> Avausharjoituksen käyttäminen </h2>
  Käyttääksesi avauskouluttajaa, avaa ensin ohjelmistotietokanta
  luotu tai jokin oikean tyyppinen. Valitse sitten Play / Training / Opening Trainer.
  Tuleva dialogi tarjoaa joitain vaihtoehtoja seuraavasta koulutuksesta
  istunto
  <ul>
      <li><term>valkoinen</term>/<term>musta</term>/<term>molemmat</term> on
      käytetään valitsemaan aukon puoli harjoittelua varten
      </li>
      <li><term>Salli vain parhaat liikkeet </term> käsittelee huonommin arvostettuja liikkeitä
      virheenä. Linjan luokitus saadaan NAG-arvoista.</li>
      <li><term> Vastustaja pelaa parhaat liikkeet </term> scidCommunity pelaa aina
      paras jatko ohjelmistotietokannan mukaan. Jos
      valitsematon scidCommunity voi valita myös alemman arvosanan
      jatkot. Tämä on hyödyllistä oppia myös kiistat.
      </li>
      <li><term>Vain merkityt rivit</term> scidCommunity toistaa vain rivit
      peleistä, jotka on merkitty <term> Opening for White</term> tai
      <term>Aukko mustalle </term>.
      </li>
      <li><term> Nollaa tilastot </term> nollaa tilastot
      ennen harjoittelua. </li>
  </ul>
  Paina <term>Continue</term> -painiketta jatkaaksesi harjoittelua.
  </p>
  <p>
  Varsinainen avauskouluttaja tulee näkyviin. Täällä voi näyttää
  mahdolliset ehdokasliikkeet (oletusarvoisesti piilotettu) ja näyttävät myös niiden
  arvot ottamalla nämä toiminnot käyttöön. Jos <term>Näytä
  tilastot </term> on käytössä, nykyiset tilastot näytetään
  värikoodatut kentät valintaruudun alla. Muuten kokonaisuus
  tilastoihin pääsee painikkeella <term>Näytä raportti</term>
  
  <h3> Valmentajan avaustilastot </h3>
  <p>
  Näyttöön tulee neljä numeroa, jotka näyttävät nykyisen sijainnin tilastot:
  <ul>
  <li><term>Vihreä</term> käyttäjän suorittamien liikkeiden määrä
  ovat hyviä liikkeitä </li>
  <li><term>Keltainen</term> pelattujen arveluttavien liikkeiden määrä
  ohjelmistossa </li>
  <li><term>Punainen</term> pelattujen liikkeiden määrä, jotka eivät ole
  ohjelmisto </li>
  <li><term>Valkoinen</term> kuinka monta kertaa sijainti oli
  havaittu </li>
  </ul>
  </p>
  
  <h3>Raportti </h3>
  <p>
  Raportti näyttää tilastot koko ohjelmistosta ja antaa
  tietoja käyttäjän tiedosta:
  <ul>
  <li><term>Repertuaarissa olevat paikat </term> kokonaismäärä
  paikat ohjelmistossa (kaikki rivit tietokannassa) </li>
  <li><term>Ei pelatut paikat </term> paikat, joita ei koskaan pelattu
  havaittu </li>
  <li><term>Pelatut paikat </term> pelatut paikat ja
  niiden tapaamisten lukumäärän summa. Huomaa, että tämä
  luku edustaa paikan esiintymien summaa kaikissa
  avausrivit: tästä määrästä voi nopeasti tulla suuri positio
  jotka ovat lähellä aloituskohtaa </li>
  <li><term> Menestys </term> pelaajan tekemien hyvien liikkeiden määrä </li>
  <li><term>Epäilyttävät liikkeet </term>
  soitin </li>
  <li><term> Repertuaarin ulkopuolella </term>
  soitin, joka ei ollut ohjelmistossa </li>
  </ul>
  </p> 
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,SeriousGame) "Vakava peli-ikkuna"
set helpText(U,SeriousGame) {<h1>Vakava peliikkuna </h1>
  <p>
  Vakavia pelejä voi pelata mitä tahansa <term>UCI</term> -moottorisarjaa vastaan
  valmis käytettäväksi scidCommunityn kanssa. Luettelo kaikista mahdollisista vastustajista on
  annettu <term>Game configuration </term> -ikkunan yläosassa. The
  painike <term> Konfiguroi UCI-moottori </term> antaa lisäksi pääsyn
  moottorin parametreihin. Oletusarvoisesti ne on asetettu kuten
  <a Analysis List>moottorikokoonpano </a>.
  </p>
  <p>
  Seuraavaksi avauksista voidaan valita käytettävä kirja
  kirjat scidCommunityn saatavilla. Poista valinta <term>Käytä kirjaa</term> -ruudusta
  poistaa avauskirjan käytön ja moottori käynnistyy
  laskemalla liikkeitä heti alusta alkaen.
  </p>
  <p>
  Osiossa <term>Time mode </term> voit asettaa ajastuksen, jota käytetään
  moottori. Eri asetukset ovat mahdollisia täällä:
  <ul>
     <li><term> Aika + bonus</term> määrittää ajan koko
     peli ja mahdollinen lisäys liikettä kohti (Fisher-kello). The
     oletusarvo on 5 minuuttia per peli ja 10 sekunnin lisäys per peli
     liikkua, joka on tavallinen asetus Blitz-peleissä. Huomaa, että
     Mustavalko-ajat voidaan asettaa itsenäisesti. Tämä mahdollistaa
     asettaaksesi moottorille lyhyen ajan ja antamaan pidemmän ajan
     ajatteluaikaa pelaajalle ja näin vahvistaen
     pelaajat analysoivat mahdollisuuksia heikentäen samalla moottoreita
     kyvyt, jos <term> Pysyvä ajattelu </term> on pois päältä (katso
     alla).
     </li>

     <li><term> Kiinteä syvyys </term> ei aseta peliaikaa, mutta
     syvyys, jonka moottori laskee puoliliikkeessä. Kuten tämä
     poistaa käytöstä mahdollisuuden laskea syvemmälle tarvittaessa
     tietokone ei näe tiettyjä kavereita ja yhdistelmiä, moottoria
     voi pelata heikommin ja tarjota siten paremman kumppanin harjoitteluun
     tarkoituksiin.
     <p>
     <b>Huom</b>: Jotkut, erityisesti kaupalliset, moottorit tarjoavat myös
     heikentää vahvuuttaan Elon yksiköissä. Todennäköisesti tämä tarjoaa a
     sopivampi algoritmi kuin hakusyvyyden rajoittaminen. scidCommunityssa
     tällaisia pelejä tarjotaan myös nimellä <a TacticalGame>Taktiset pelit </a>
     vapaata Phalanx-moottoria vastaan.
     </p>
     </li>

     <li><term>Nodes</term> on samanlainen kuin hakusyvyyden rajoittaminen,
     mutta tässä moottorin täytyy liikkua tietyn arvioinnin jälkeen
     paikkojen määrä. (Oletusarvo on 10 000.)
     </li>

     <li><term> Sekuntia liikettä kohden </term> antaa moottorin käyttää
     korkeintaan tietyn ajan tietyssä paikassa. Jotkut
     moottorit liikkuvat nopeammin tietyissä olosuhteissa, mutta ne toimivat
     älä ylitä tässä asetettua aikarajaa. Kuten <term> Kiinteä syvyys </term>
     ja <term>Nodes</term> tämä rajoittaa myös moottorien pelaamista
     vahvuus, mutta antaa myös melko herkän pelin.
     </li>
  </ul>
  </p>
  <p>
  Vakavat pelit voivat alkaa nykyisestä laudan asennosta, jos laatikko
  <term> Aloita nykyisestä sijainnista </term> on valittu. Tämä mahdollistaa
  esim. pelataksesi määriteltyjä keskimmäisiä pelipaikkoja, jotka syntyvät an
  avaaminen.
  </p>
  <p>
  <term> Pysyvä ajattelu </term> (joskus kutsutaan myös pohtimiseksi)
  antaa moottorin laskea pelaajien aikaa. Jos ei ole valittuna,
  moottori lopettaa sijainnin analysoinnin, jos pelaaja saa liikkeen.
  Jos peli on asetettu kiinteäksi ajaksi siirtoa kohti, tämä heikentää peliä
  moottori. Toisaalta moottori saattaa liikkua välittömästi, jos
  pelaaja teki liikkeen, joka analysoi pelaajien aikaa.
  </p>
  <p>
  <term>Valmentaja katselee</term> avaa vuoropuhelun ja tarjoutuu ottamaan vastaan
  takaisinsiirto, jos pelaaja teki virheen (moottoreiden takia
  arvio hänen viimeisestä liikkeestään).
  </p>
  <p>
  Aukkojen koulutukseen <term>Erityinen aukko </term> voi olla
  tarkistettu. Alla olevasta listasta voit valita avauksen, jonka haluat pelata. The
  Pelaajan tulee sitten seurata valittua linjaa, muuten scidCommunity kysyy
  jos siirto pitäisi ottaa takaisin.
  </p>

  <p>
  Kun olet asettanut kaikki pelin parametrit ja painanut Play
  -painiketta, scidCommunity asettaa vastustajan moottorin näyttämään kellot ja
  aloita peli. Pelaaja ei saa tehdä liikettä ennen kelloa
  näkyviin. Huomaa, että shakkimoottorin käynnistyminen saattaa kestää jonkin aikaa
  käynnistä ja alusta kunnolla.
  </p>

  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,TacticsTrainer) "Koulutus: Taktiikka"
set helpText(U,TacticsTrainer) {<h1> Koulutus: Tactics </h1>
  <p>
  scidCommunity tarjoaa mahdollisuuden ratkaista shakkipulmia. Tätä ominaisuutta varten
  tarvitaan erityisiä tietokantoja, jotka sisältävät arvoituksia. Nämä
  tietokantoja etsitään hakemistosta <term>Bases</term>, joka voi
  määritetään valikon Options / Bases -hakemiston kautta. Toisin kuin muut
  Nämä pohjat eivät yleensä sisällä kokonaisia pelejä, vaan vain a
  lähtöasema, kuten tavallisesta taktiikkapalapelistä hyvin tiedetään
  kirjat. Itse asiassa jokainen pulmakirja voidaan helposti muuntaa sellaiseksi
  harjoituspohjaan vain asettamalla paikat ja tallentamalla ne
  <term> Bases</term> -hakemistosta. Lisäksi on asetettava
  <term>Tactics</term> -tukikohdan tyyppi <a
  Maintenance>Maintenance</a> -ikkunan avulla.
  </p>
  <p>
  Kun olet valinnut Play / Training / Tactics, näkyviin tulee dialogi
  mahdollistaa harjoituspohjan valinnan. Siellä on tukikohdan nimi
  näytetään, minkä jälkeen ratkaistujen pulmien määrä ja kokonaismäärä
  pulmapelien määrä pohjassa suluissa. Eli scidCommunity tallentaa
  arvoituksia, jotka käyttäjä on jo ratkaissut pohjan avulla. Pohjan valinta
  napsauttamalla <term>Reset scores</term> -painiketta nollaat tämän
  tiedot, jotka merkitsevät kaikki pulmat ratkaisemattomiksi.
  </p>
  <p>
  <b>Huomaa</b> on suositeltavaa sulkea <a PGN>PGN</a>-ikkuna ja tarkistaa
  <term>piilota seuraava siirto</term> tiedon kontekstivalikossa
  scidCommunityn pääikkunan alue. Muuten pettäminen on melko yksinkertaista.
  <p>
  Ratkaisun saamiseksi tukikohdan pulmiin paikat ovat
  analysoidaan minkä tahansa shakkikoneen avulla, jonka käyttäjä on määrittänyt. The
  <term> Rajoita moottorin analyysiaikaa </term> liukusäätimen avulla voit rajoittaa
  aika, jonka moottorin on ratkaistava asema. Useita sekunteja pitäisi olla
  riittää useimmissa tapauksissa, koska yleensä taktiset pulmat sisältävät a
  pakotettu jatko, jonka melkein kaikki löytävät nopeasti
  shakkimoottorit.
  </p>
  <p>
  Napsauta <term>Continue</term> -painiketta aloittaa harjoituksen,
  näyttää ensimmäisen ratkaisemattoman palapelin. Eli on mahdollista
  jatkaa työtä tukikohdan kautta. Myös jos jokin palapeli jäi väliin
  ensimmäinen istunto tai ratkaisematon, se näytetään uudelleen. Uusi ikkuna
  tulee näkyviin, ja se sisältää kellon ja useita painikkeita. Kello on
  vain, jotta käyttäjä voi tarkistaa, kuinka kauan hän ajatteli paikkaa
  käsi. Ongelman ratkaisemiseen tarvittavaa aikaa ei arvioida.
  </p>
  <p>
  Jotkut taktiset harjoitukset eivät pääty pariin, vaan oikeaan
  ratkaisu antaa selkeän edun. Jos joku haluaa pelata näitä
  skenaariot ja laske vain ratkaistu harjoitus voiton tapauksessa
  valitse <term>Voit voittanut pelin </term>. (Tässä vaihtoehdossa ei ole
  tarkoittaa selkeää mate-liuosta.)
  </p>
  <p>
  Jos ongelmaa ei voida ratkaista, voidaan tarkistaa 
  <term>Näytä ratkaisu</term> -valintaruutu. Ratkaisu näytetään sitten
  alla tummanharmaalla kentällä.
  </p>
  <p>
  Napsauttamalla <term>Seuraava</term> -painiketta käyttäjä voi ohittaa
  palapeli ja jatka eteenpäin, <term>Abort</term> -painike lopettaa taktisen
  koulutusta ja sulje tietokanta. <term>Next</term> lisäksi
  -painiketta, käyttäjä voi valita harjoituksen millä tahansa keinolla
  valitse peli scidCommunityn tietokannasta, esim. valitsemalla satunnainen
  Peli Ctrl-? tai hyppäämällä johonkin kirjanmerkkiin tai yksinkertaisesti <a
  GameList>peliluettelon </a> kautta.
  </p>
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,FindBestMove) "Harjoittelu: Löydä paras liike"
set helpText(U,FindBestMove) {<h1> Harjoittelu: Löydä paras liike </h1>
  <p>
  Kun kirjoitat pelejä shakkimoottorilla, se voi etsiä
  taktiset mahdollisuudet pelissä. Tämä voidaan saavuttaa asettamalla
  <term>Merkitse taktinen harjoitus </term> <a
  Analysis>Annotation</a> -ikkunassa, joka on käytettävissä analyysistä. Tapauksessa a
  Jos taktinen tilaisuus löytyy, scidCommunity merkitsee pelin
  <term>T</term> -lippu (Tactics) ja lisää erityinen kommentti, joka on
  arvioitu tässä harjoituksessa.
  </p>
  <p>
  Tämän koulutusmenetelmän käyttämiseksi tarvitaan asianmukaisesti valmisteltu tietokanta
  vaaditaan. Tämä voidaan saavuttaa merkitsemällä erää pelejä tai
  voit ladata ne <url
  http://scid.sourceforge.net/>scidCommunity-verkkosivustolta </url>.
  Kun olet avannut oikein valmistetun tietokannan, valitse Play /
  Harjoittelu / Löydä paras liike. scidCommunity siirtyy sitten seuraavaan sijaintiin
  taktisen iskun nykyisestä pelipaikasta. Tarvittaessa a
  sopiva uusi peli ladataan ja scidCommunity näyttää kriittisen
  asema. Käyttäjän on nyt löydettävä paras jatko.
  Voit siirtyä seuraavaan taktiseen paikkaan napsauttamalla hiiren kakkospainikkeella
  Siirry pelin lopetuspainikkeeseen.
  </p>
  <p>
  Tätä harjoitusta varten on suositeltavaa sulkea <a PGN>PGN</a> ikkuna ja asettaa
  <term>Piilota seuraava siirto</term> tilaalueiden kontekstivalikosta.
  </p>
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,FICSLogin) "FICS-kirjautuminen"
set helpText(U,FICSLogin) {<h1>FICS-kirjautuminen </h1>
  <p>
  Ilmainen Internet Chess Server (FICS) on hyvä paikka pelata shakkia
  verkossa eri puolilla maailmaa olevien ihmisten kanssa eri pelivahvuuksilla.
  Yksi suurista eduista on, että voi pelata ihmisvastustajia.
  Lisäksi FICS tarjoaa luokitusjärjestelmän, jonka avulla voidaan testata
  omia voimia ja seurata omaa edistymistä. Lisäksi FICS-releet
  kansainvälisiä turnauksia, joita voi seurata ja keskustella elämästä
  palvelimella ja koulutusvaihtoehtoja on useita. a
  yksityiskohtainen kuvaus tarjotuista palveluista, kuinka tulla a
  FICS:n jäsen jne. katso FICS:n kotisivut osoitteessa
  http://www.freechess.org.
  </p>
  <p>
  Vaikka periaatteessa FICS:ää voidaan käyttää tavallisen telnet-ohjelman kanssa
  Oikealla shakkiohjelmalla pelaaminen tarjoaa useita etuja.
  Siksi scidCommunity tarjoaa käyttöliittymän tälle palvelimelle. Perustaaksesi a
  yhteys palvelimeen on kirjauduttava ensin ja useita
  parametrit vaaditaan:
  <ul>
      <li><term>Kirjaudu sisään:</term> Tämä on kirjautumisnimesi FICS:ssä
      palvelin. Sen arvo tallennetaan scidCommunityn kokoonpanoon myöhempää käyttöä varten
      käytä uudelleen. </li>
      <li><term>Salasana:</term> määrittää salasanasi kirjautumista varten.
      <b>Huomaa</b>, että tämä salasana näytetään, kun kirjoitat,
      antaa kaikkien lukea sen. Lisäksi tämä salasana on
      tallennettu pelkkänä tekstinä scidCommunityn määrityksiin. Jos olet
      käyttämällä julkisesti saatavilla olevaa järjestelmää, muista määrittää
      oikeat oikeudet scidCommunityn asetushakemistoon.
      </li>
      <li><term> Aikatiiviste </term>, jos valittu, kaikki liitännät
      FICS-palvelin reititetään <term> aikatiivisteen </term> kautta
      ohjelma. <term>aikatiivisteen </term> tarkoitus on selviytyä
      verkkoviiveet ja kellojen pitäminen oikeassa järjestyksessä, se tarkoittaa
      että sinun ei pitäisi hävitä peliä ajoissa yksinkertaisesti siksi, että olet päällä
      erittäin hidas verkkoyhteys. Sopiva
      <term>timeseal</term> -ohjelma käyttöjärjestelmällesi
      valitaan seuraavalla syöttörivillä. Se on saatavilla ilmaiseksi,
      mutta se on ladattava erikseen osoitteesta
      http://www.freechess.org.
      </li>
      <li><term>Palvelinportti</term> määrittää palvelimen portin.
      Oletusarvo on 5000 ja sen pitäisi olla ok lähes kaikkiin tarpeisiin. </li>
      <li><term> Timeseal-portti </term> määrittää portin, jossa
      <term>timeseal</term> -ohjelma kuuntelee. Oletusarvo on 5001
      ja sen pitäisi olla ok lähes kaikkiin tarpeisiin. </li>
   </ul>
   Kaikki nämä asetukset tallennetaan scidCommunityn kokoonpanoon ja
   siksi se on syötettävä vain kerran.
   </p>
  <p>
  Kun olet tarkistanut asetukset, voit muodostaa yhteyden FICS-palvelimeen
  napsauttamalla <term>Yhdistä</term> -painiketta. Vaihtoehtoisesti Sicd tarjoaa
  anonyymi kirjautuminen valitsemalla <term>Kirjaudu vieraana </term>. Tässä
  -tilassa voit kokeilla kaikkia FICS-pelin toimintoja siellä nimettömänä, mutta
  et voi pelata luokiteltuja pelejä tai saada luokitusta
  itseäsi. Vierastilin ja tavallisen tilin välisen eron vuoksi
  katso dokumentaatio FICS-kotisivulta.
  </p>
  <p>
  <b>Huom</b> Tavallisen shakin lisäksi FICS tarjoaa myös joukon shakkia
  muunnelmia, kuten bughouse tai crazyhouse jne. scidCommunity ei tue mitään
  näistä muunnelmista, joten et voi toistaa niitä scidCommunitylla. Jos sinä
  Jos haluat pelata muunnelmia, voit halutessasi tutustua muihin käyttöliittymiin.
  FICS tarjoaa joukon graafisia käyttöliittymiä ladattavaksi
  kotisivulle.
  </p>
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,FICSfindOpp) "FICS Etsi vastustaja"
set helpText(U,FICSfindOpp) {<h1>FICS Etsi vastustaja </h1>
  <p>
  Tämä dialogi tarjoaa kätevän tavan haastaa muita pelaajia
  peli, FICS:ssä puhu <term>ase a seek </term>. Tätä varten useita
  parametrit on asetettava:
  <ul>
      <li><term>Alkuaika (min) </term> asettaa aloitusajan
      peli minuuteissa. </li>
      <li><term>Inkrementti (s)</term> määrittää askeleen lisäyksen,
      tämä vastaa <term> Fisher Clockia </term>. Sen asettaminen
      0 saa pelin kestämään <term> Alkuaika </term> minuuttia.
      </li>
      <li><term> Arvioitu peli </term> Jos tämä on valittuna, peli luokitellaan,
      poista valinta, jos haluat pelata vapaa-ajan peliä. </li>
      <li><term>väri</term> Jos asetus on automaattinen,
      vastustaja voi valita värin, jota hän haluaa pelata, hyväksyt
      joko hän valitsee. Jos haluat pelata mustaa tai valkoista,
      merkitse jompikumpi näistä vaihtoehdoista.
      </li>
      <li><term>Raja-arvo välillä </term> antaa sinun tarjota pelin
      pelaajille tietyllä luokitusvälillä. Käyttämällä tätä vaihtoehtoa voi
      vakuuttaa, että pelaat vastustajia luokitusalueellasi ja siten
      hyvä peli.
      </li>
      <li><term> Vahvista manuaalisesti </term> antaa sinun vahvistaa tai hylätä
      pelissä, kun toinen pelaaja hyväksyi haasteesi. </li>
      <li><term> Suodatin kaavalla</term> FICS:ssä jokainen pelaaja voi
      aseta kaava, joka kuvaa, mitkä haasteet hylätään
      automaattisesti. Tämä kaava voidaan ottaa käyttöön valitsemalla tämä ruutu.
      </li>
   </ul>
   Napsauttamalla <term>Issue seek </term> -painiketta saat
   tarjous palvelimella.
  </p>
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,FICS) "FICS: Pelaa Internetissä"
set helpText(U,FICS) {<h1>FICS: Pelaa Internetissä </h1>
  <p>
  Ikkuna on jaettu vaakasuoraan hinauksen pääosiin. Päällä
  konsoli-ikkuna tulee näkyviin. Tässä kaikki palvelimelle lähetetyt viestit tai
  palvelimelta haettu näy. Normaalit viestit kirjoitetaan sisään
  vihreä, pelitarjoukset muilta pelaajilta näkyvät punaisena, komennot lähetetään
  palvelimelle on liitetty kehotteeseen.
  </p>
  <p>
  Vuorovaikutus FICS:n kanssa on komentopohjaista. Siksi alla
  konsoli-ikkuna on komentorivi. Täällä käyttäjä voi kirjoittaa komentoja
  lähetetään palvelimelle joko painamalla enteriä tai <term>lähetä</term>
  -painiketta. Kaikkien FICS:n komentojen kuvaaminen ei kuulu tähän
  FICS tarjoaa kuitenkin kattavan online-apujärjestelmän. Vastaanottaja
  katso luettelo mahdollisista komennoista, joita voidaan antaa <term>help
  komennot </term>. Nähdäksesi tietyn yksityiskohtaisen dokumentaation
  komento lisää sen nimen eteen tekstillä <term>help</term>. Huomaa, että a
  komennolla voi olla useita ohjesivuja. Vieritä alas antamalla
  <term>seuraava</term> -komento.
  </p>
  <p>
  Komentorivin alapuolella dialogi on jaettu kahteen osaan. Käytössä
  vasemmalla puolella kellot näkyvät, yksi valkoinen ja yksi musta.
  Kellon napsauttaminen pysäyttää sen, analogisten kellojen sisällä a
  digitaalinen esitys näkyy.
  </p>
  <p>
  Kellojen oikealla puolella näkyvät komentopainikkeet:
  <ul>
    <li><term>Hiljaisuus </term> suodattaa pois suurimman osan viesteistä
    FICS, joita ei ole nimenomaisesti kohdistettu käyttäjälle. Se on
    vastaa FICS-komentojen lähettämistä 
    <ul>
    <li>set gin 0</li>
    <li> aseta haku 0 </li>
    <li> aseta hiljaisuus 0 </li>
    <li> asetettu kanavanvaihto 1 </li>
    </ul>
    </li>
    <li><term> Tarjoukset </term> näyttää graafisen näytön
    nykyiset pelitarjoukset. Y-akselilla näkyy Elo-luokitus
    vastustaja (mitä korkeampi hänen tasonsa, sitä korkeammalle tarjous ilmestyy),
    kun taas kaavion x-akseli näyttää pelien ajoituksen (
    mitä hitaampi peli on). Ensimmäinen punainen viiva
    merkitsee vakio <term> Blitz </term> -ajoitus (5 min., ei lisäystä)
    kun taas toinen punainen viiva merkitsee standardia <term> Rapid </term>
    ajoitus (15 min, ei lisäystä). Lisäksi tarjoukset käyttävät
    seuraava koodaus:
    <ul>
       <li><green> Vihreä </green>: tarjoukset ihmisvastustajilta </li>
       <li><blue> Sininen</blue>: tarjoukset tietokoneiden vastustajilta </li>
       <li><red>Punainen</red>: pelit, joiden kokonaisaika on yli 1 tunti </li>
       <li><gray>Harmaa</gray>: anonyymit tarjoukset, eli tarjoukset vieraskirjautuneilta </li>
       <li> Laatikot: luokittelemattomat pelit </li>
       <li>Piirit: arvioidut pelit </li>
    </ul>
    Vie hiiren osoitin tietyn tarjouksen päälle, näet kaikki tiedot
    tekstimuoto:
    <ul>
       <li>pelin numero </li>
       <li>pelaajien kirjautumiskahva </li>
       <li>soittimen luokitus suluissa </li>
       <li>alkuaika / ajan lisäys </li>
       <li>sana "luokitus" tai "luokittamaton" tarjouksesta riippuen </li>
       <li> sana "[valkoinen]" tai "[musta]", jos vastustaja haluaa
       toista vain määritettyä väriä </li>
    </ul>
    Hyväksy tarjous napsauttamalla symbolia.
  <li><term>Etsi vastustaja</term> avaa <a FICSfindOpp>dialogin</a>
  joka mahdollistaa tarjouksen tekemisen. </li>
  <li><term>Draw</term> tarjoaa tasapelin käynnissä olevassa pelissä</li>
  <li><term>Abort</term> keskeyttää käynnissä olevan pelin</li>
  <li>term>Resign</term> irtisanoo käynnissä olevan pelin</li>
  <li><term>Takeback</term> ottaa puoliliikkeen takaisin, hyödyllinen
  analyysi </li>
  <li><term>Takback 2</term> ottaa täyden liikkeen takaisin, hyödyllinen
  analyysi </li>
  <li><term>Games</li> antaa luettelon palvelimella olevista peleistä.
  Huomaa, että FICS-konsolin katsotaan olevan 80 merkkiä leveä, joten
  hyvän taulukon saamiseksi olisi tarpeen muuttaa FICS-ikkunan kokoa.
  </li>
  <li>
  <li><term>Sulje</term> sulkee yhteyden FICS:ään</li>
  </ul>
  </p>

  <h3><name Training>FICS-luennot </h3>
  <p>
  FICS tarjoaa useita vaihtoehtoja shakkiharjoitteluun. Yksi useista
  näkyvästi kerran ovat luentobotit <term> LectureBot </term> ja
  <term>WesBot</term>. Ne toimivat koko ajan FICS:ssä ja tarjoavat erilaisia
  koulutustilaisuuksia, joihin voi vierailla scidCommunityn avulla. Jokaisen alku
  istunto julkistetaan FICS:n <term>Channel 67</term> -kanavalla. Siksi
  nähdäksesi nämä ilmoitukset, sinun tulee ensin lisätä tämä kanava
  henkilökohtainen havaintolista. Tämä voidaan tehdä <term>+kanavalla
  67</term> (se voidaan poistaa uudelleen <term>-kanavalla 67</term>).
  Kerran esim. LectureBot ilmoittaa harjoittelun, johon voi osallistua
  julkaisemalla <term>observe readerbot</term>. Katso
  FICS:n online-dokumentaatio botien lisäominaisuuksista ja
  myös muita botteja saatavilla.
  </p>

  <h3><name Observe> Tarkkaile pelejä FICS:ssä</h3>
  <p>
  Ajoittain FICS <term> välittää </term> suuria tapahtumia
  kansainvälinen shakki. Näissä tapauksissa voi seurata pelien elämää
  palvelimella ja keskustele niistä muiden FICS-käyttäjien kanssa. Ota selvää
  mitä pelejä tällä hetkellä välitetään (jos sellaisia on), voit kysyä välittäjältä
  luettelo <term> relay listgames</term>. Kuten FICS odottaa terminaalilta
  80 merkin leveyden saamiseksi scidCommunityn FICS:n kokoa voi olla tarpeen muuttaa
  ikkunasta saadaksesi mukavan pöydän. Taulukon merkinnät ovat ensin
  pelin numero, kaksoispiste, kuin vastustajat, pelin tulos (*
  tarkoittaa jatkuvaa peliä tavalliseen tapaan) ja <a ECO>ECO-koodia </a>
  avaus. Tietyn pelin tarkkailemiseksi voi vain <term> tarkkailla
  pelinumero </term>. scidCommunity näyttää sitten nykyisen taulun
  asennossa, kellot näyttävät oikeat arvot, jotka on lähettänyt
  rele ja se hakee kaikki pelin tähän mennessä liikkeet sekä tavalliset liikkeet
  <a PGN>PGN</a> otsikkokentät. Jos pelaaja liikkuu, tämä siirto suoritetaan scidCommunityssa
  kuten tavallista. Jos haluat keskustella pelistä muiden tarkkailijoiden kanssa,
  Voidaan käyttää <term>kuiskausta </term> ja <term>kibitsiä </term>. Ole hyvä
  katso näiden komentojen online-apua. Kaikki nämä keskustelut
  voidaan lukea konsolista.
  </p>
  <p>
  Huomaa, että vain yksi peli voidaan havaita scidCommunityssa.
  </p>

  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,BookTuning) "Kirjan viritys"
set helpText(U,BookTuning) {<h1>Kirjan viritys </h1>
   <p>
   Jokaiselle kirjan siirrolle annetaan prosenttiosuus, jossa ilmoitetaan todennäköisyys
   että scidCommunity käyttää tätä siirtoa. Käyttämällä <term>Book Tuning </term> yksi
   voi säätää näitä arvoja. Ensinnäkin paikka, jossa viivojen pitäisi
   on perustettava. Soitettuasi Työkalut / Kirjan viritys
   saa pienen ikkunan, jossa ilmoitetaan kirjan siirrot ja niiden prosenttiosuudet
   spin boxissa. Huomaa, että siksi näytetään vain kokonaislukuarvot
   0 voi ilmestyä, mikä tarkoittaa, että tämän liikkeen todennäköisyys on "vähemmän".
   kuin 1 %". (Todennäköisesti tämä tapahtuu automaattisesti luodussa
   kirjat pelikokoelmista.) Kaikki luvut ovat tietysti 100 %.
   </p>
   <p>
   Voit selata kirjan osia napsauttamalla
   kirjan viritysikkunassa tai liikkua pelissä tavalliseen tapaan
   scidCommunityssa.
   </p>
   <p>
   Todennäköisyyden säätämiseksi esim. nostaa tietyn todennäköisyyttä
   vaihtelua, sen arvoa voi vain lisätä. Vaikka muut arvot
   pysy ennallaan, scidCommunity laskee uudelleen, kun <term>Save</term> on
   painetaan.
   </p>
   <p>
   Jos valitset <term>Export</term>, kirjan haara viedään
   nykyisestä sijainnista yhdeksi peliksi. Jatkoa
   suurimmalla todennäköisyydellä muodostavat pääradan, kun taas kaikki
   muut on tallennettu muunnelmina. Tämä mahdollistaa puolikäsin
   valitaan rivit sisällytettäväksi uuteen luotavaan kirjaan. Huomaa,
   että scidCommunity pystyy käsittelemään 3000 siirtoa yhdessä pelissä, joten se kestää
   ei todennäköisesti ole mahdollista (eikä se ole kovin järkevää).
   viedä koko aloituskirjan yhdeksi peliksi. Huomaa myös, että vienti
   voidaan tehdä asteittain. Eli uusia rivejä on jo lisätty
   olemassa olevia. Tämä mahdollistaa myös useiden kirjojen yhdistämisen.
   </p>
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,Novag) "Novag Citrine Chess -laudan liittäminen"
set helpText(U,Novag) {<h1>Novag Citrine Chess -shakkilaudan liittäminen </h1>
   <p>
   Novag Citrine on puinen shakkilauta, johon voidaan liittää
   PC:ltä sarjaliitännän kautta. Sitä voidaan käyttää scidCommunityn kanssa
   osallistua peleihin, pelata tietokonevastustajaa vastaan tai FICS:ssä
   tarjoaa "luonnollisen" shakkikäyttöliittymän.
   </p>
   <p>
   <b>Huomautus</b>: Ennen kuin korttia voidaan käyttää, sinun <a
   HardwareConfig>portti on määritettävä käytettäväksi.</a>
   </p>
   <p>
   Kun oikea portti on asetettu, valitse Työkalut / Yhdistä laitteisto /
   Yhdistä Novag Citrine liittääksesi taulun tai napsauta vain
   laitteiston liitäntäpainike <button tb_eng_disconnected>. Tämä
   -painike näyttää myös <a HardwareStatus> -tilan
   liitäntä. </a>

   ###--- Yksityiskohtainen kuvaus tarvitaan ---###
   </p>
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,HardwareConfig) "Ulkoisen laitteiston liittäminen"
set helpText(U,HardwareConfig) {<h1>Ulkoisen laitteiston liittäminen </h1>
  On olemassa kahdenlaisia laitteita, joita voidaan käyttää scidCommunityn kanssa pelaamiseen
  tai syötepelejä. Valitse <term>Hardware</term> -luettelosta se
  haluat käyttää:
  <ul>
    <li><term>Novag Citrine</term> (ja yhteensopivat levyt) käyttävät
    sisäinen ohjain, joka on kehitetty erityisesti Novagia varten
    Citrine board, mutta voi olla muitakin levyjä, jotka tukevat
    tämä protokolla.  Tämä kuljettaja sallii liikkeitä, mutta laudat
    logiikka ei tunnista laudalle asetettua asemaa eikä
    palasia sellaisenaan.
    </li>
    <li><term> Input Engine </term> -ajurit on tarkoitettu ilmaisiksi,
    avoin käyttöliittymä minkä tahansa laitteiston kytkemiseksi johonkin graafiseen käyttöliittymään, kuten scidCommunity. Se
    on mallinnettu shakkimoottorin tavanomaisen tyylin mukaan. The
    protokollan spesifikaatiot sekä sopiva ajuri
    DGT:n elektroniset shakkilaudat löytyvät <url
    http://dgtdrv.sourceforge.net>dgtdrv-verkkosivustolta </url>.  Riippuen
    laitteisto, jota hallitus voi tietää asetetut paikat ja
    palasia liikkeellään. Tämä on mm. DGT-lautakuntien tapauksessa.
    </li>
  </ul>
  <p>
  <b>Huomaa</b> scidCommunity ei sisällä oletusarvoisesti mitään syöttömoottoria. Syöte
  moottorit on tarkoitettu itsenäisiksi ohjelmiksi, joita voidaan käyttää a
  erilaisia GUI:ita.
  </p>
  <p>
  Kun olet valinnut laitteiston käyttääksesi ainakin porttia, tämä laitteisto
  on yhdistetty, on määritettävä. Toiminnasta riippuen
  järjestelmä ja tämän portin käyttökortti vaihtelevat. Yleensä kuitenkin
  ulkoinen laitteisto on kytketty sarjaporttiin, USB:hen tai Bluetoothiin
  yhteys, jossa kaksi jälkimmäistä ovat vain sarjan johdannaisia
  yhteyksiä. Alustasta riippuen portin tavalliset nimet
  kysymykset ovat:
  </p>
  <ul>
    <li><term>Unix</term> (sis. <term>Linux</term>): yleensä tiedosto
    <term>/dev</term> -hakemistossa käytetään. Sarjaporteille
    yleinen nimitys on <term>/dev/ttyS0</term>, ensimmäiselle sarjalle
    portti, <term>/dev/ttyS1</term>, toiselle ja niin edelleen. varten
    USB-sarjalaitteiden yleisiä nimiä ovat <term>/dev/ttyUSB0</term>
    ensimmäiselle, <term>/dev/ttyUSB1</term> toiselle ja niin edelleen.
    Muita harvinaisempia nimiä ovat <term>/dev/usb/tts/*</term> tai
    <term>/dev/usbdev*</term> (jossa tähti * tarkoittaa jotain
    lisänimi). BlueTooth-laitteet näkyvät yleensä muodossa
    <term>/dev/rfcomm0</term> ensimmäiselle, <term>/dev/rfcomm1</term>
    toiselle ja niin edelleen.
    </li>
    <li><term>MacOS</term>:
    ###--- Mac OS X:n nimeämiseen vaadittavat tiedot ---###
    </li>
    <li><term>Windows</term> noudattaa tavallista DOS-käytäntöä, jossa
    sarjaportit on merkitty <term>COM1:</term>,
    <term>COM2:</term> ja niin edelleen. Tämä nimeäminen pätee myös
    muuntimia, mutta joskus ne saavat lukuja yli 4.
    </li>
    <li><term>Näytä-painike </term> ottaa käyttöön <a
    HardwareStatus>laitteiston liitäntäpainikkeen </a> työkalupalkissa, jos
    tarkistettu. Jos tätä ei ole valittu, painike ei tule näkyviin tilan säästämiseksi.
    Painikkeen poistaminen edellyttää scidCommunityn uudelleenkäynnistämistä.
    </li>
  </ul>
  <p>
  <b>Huomautus</b>: jos kortti on kytketty USB:n avulla sarja- tai
  Bluetooth-sarjamuunnin, nämä sovittimet näkyvät yleensä
  myös yllä oleva kaavio.
  </p>
  <p>
  Jos Input Engine -yhteensopivaa ohjainta tulisi käyttää, toimi seuraavasti
  kentät on täytettävä (Novag-ohjaimelle ne ovat
  pois käytöstä):
  </p>
  <ul>
     <li><term> Moottorin komento</term>: Ohjelman nimi, joka on
     käytettäväksi kuljettajan moottorina. Täysin pätevä nimi voi olla
     vaaditaan, kuten <name Analysis
     List> shakkimoottorin </a> kokoonpanossa. (Esi. DGT-ohjainmoottori Linuxissa
     Järjestelmää kutsutaan yleensä nimellä <term>dgtdrv2.i686</term>.)
     </li>
     <li><term> Moottoriparametri </term>: Tässä kentässä annettu teksti
     välitetään parametreina kuljettajan moottorille. Arvot
     tässä vaaditut määrät riippuvat kuljettajasta, ja ne on ilmoitettava sen sisällä
     dokumentaatio. (Esimerkiksi DGT-ohjainmoottori tarvitsee kaksikirjaimen
     koodi, joka määrittää laudan suunnan ja liikkeet, joiden pitäisi
     lähetetään graafiseen käyttöliittymään. Ensimmäinen kirjain voi olla <term>l</term> tai
     <term>r</term> riippuen kellosta, joka istuu valkoisten vasemmalle tai
     oikealla, toinen kirjain voi olla <term>a</term>, <term>b</term> tai
     <term>w</term> riippuen siitä, onko kaikki, vain musta vai vain valkoinen
     liikkeet pitäisi lähettää.)
     </li>
  </ul>
  <p>
  Painamalla <term>OK</term> asetukset tallennetaan scidCommunityn asetuksiin
  ja käynnistä valittu ohjain välittömästi.
  </p>
  <p>
  Ulkoisen kortin tilaa voidaan valvoa <a
  HardwareStatus>Hardware status</a> -painikkeella. Tämä painike voi myös olla
  käytetään kytkemään jo määritetty laitteisto välittömästi ilman
  <term>Configuration</term> -valintaikkunan kutsuminen.
  </p>


  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,HardwareStatus) "Ulkoisen laitteiston tila"
set helpText(U,HardwareStatus) {<h1>Ulkoisen laitteiston tila </h1>
   <p>
   Tämä painike sijaitsee scidCommunityn työkalupalkin oikealla puolella. Riippuen
   ulkoisen laitteiston tila näyttää erilaisia kuvakkeita:
   </p>
   <ul>
   <li> <button tb_eng_disconnected>
   Tämä on normaali tila ohjelman käynnistyksen jälkeen ja osoittaa, että ei
   ulkoinen laitteisto on tällä hetkellä aktiivinen. Painikkeen painaminen tekee
   liitä määritetty laitteisto.
   </li>
   <li> <button tb_eng_connecting>
   scidCommunity aloitti tiedonsiirron ulkoisen laitteiston kanssa,
   alustus on käynnissä. Riippuen ajurista ja laitteistosta
   kytkettynä, voi kestää muutaman sekunnin, ennen kuin asiat selviävät.
   </li>
   <li> <button tb_eng_error>
   Viestiessä ulkoisen laitteiston kanssa jokin virhe
   tapahtui. Tavallisia ongelmien lähteitä ovat mm. toinen ohjelma
   ulkoista laitteistoa käyttäessäsi laitteistoa ei ole yhdistetty
   tietokoneeseen tai sitä ei yksinkertaisesti ole kytketty päälle. Harvinaisissa tapauksissa ulkoinen
   laitteisto voi myös toimia odottamattomasti. Yritetään muodostaa yhteys uudelleen
   korjaa ongelman, koska laitteisto nollataan yleensä, kun yhteys katkaistaan.
   Myös laitteen irrottaminen ja/tai sammuttaminen on valinnainen
   tämä tapaus. Painikkeen painaminen yrittää kytkeä laitteen uudelleen
   konfiguroitu laitteisto.
   </li>
   <li> <button tb_eng_ok>
   Yhteys on muodostettu, laite on valmis ja voi olla
   käytetään siirtosyötteeseen. Painikkeen painaminen katkaisee yhteyden
   ulkoinen laitteisto.
   </li>
   <li> <button tb_eng_dgt>
   Jos DGT:n elektroninen shakkilauta on kytketty ja valmis, tämä
   -painike tulee näkyviin. Painikkeen painaminen katkaisee yhteyden
   ulkoinen laitteisto.
   </li>
   <li> <button tb_eng_query>
   Dialogi <a HardwareConfig</a> on auki. Viimeistele konfigurointi
   ennen laitteiston kytkemistä.
   </li>
   </ul>

  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,InputEngine) "Input Moottorin ajurikonsoli"
set helpText(U,InputEngine) {<h1> Input Moottorin ajurikonsoli </h1>
   <p>
   Tämän ikkunan päällä näkyy konsoli, joka valvoo
   viestintä scidCommunityn ja kuljettajan moottorin välillä. Yleensä tämä on
   ei kiinnosta käyttäjää, mutta se voi tarjota hyödyllisiä vinkkejä
   toimintahäiriön tapauksessa. Kaikki scidCommunityn lähettämät komennot on liitetty an
   nuoli oikealle, kaikki vastaukset haettiin kuljettajan moottorista
   nuoli vasemmalle.  Konsolin alapuolella varsinainen kutsu
   scidCommunityn ohjain tulee näkyviin saadakseen tietoja.
   </p>
   <p>
   <term> Siirrot lähetetään </term> sallii rajoittaa lähettämiä liikkeitä
   ulkoinen laitteisto. Pelin syöttämistä varten laudan tulee tietysti lähettää
   liikkeet molemmille puolille. Pelin pelaamiseen kuitenkin
   vastustajan tekemät liikkeet tulisi jättää huomiotta, kuten scidCommunity tekisi
   muussa tapauksessa ilmoittaa heille "laittomina liikkeinä".
   </p>
   <p>
   Oikealla oleva pieni taulu näyttää nykyisen sijainnin.
   </p>
   <p>
   Jos liikettä tehdään, painikkeiden ja pienen väliin
   nouse suoritettuun siirtoon (<term>siirtoalue</term>) ulkoiseen
   taulu on esitetty figuriinipitkällä algebrallisella merkinnällä. Kelvollisia liikkeitä
   näkyvät <green>vihreällä</green> taustalla laittomien liikkeiden aikana
   näkyvät <red>punaisella</red> taustalla. Lisäksi laittomat liikkeet
   ilmoitetaan hälytysäänellä, jos scidCommunity on ottanut äänen käyttöön.
   Asetuksista riippuen siirrot ilmoitetaan lisäksi.
   </p>
   <p>
   <term>Info</term> -painike hakee tietoja kuljettajalta
   moottori. Näiden tietojen laajuus riippuu moottorista, mutta
   sen pitäisi yleensä antaa niin paljon kuin on saatavilla ulkoisesta
   laitteisto ja itse ohjain. Lisäksi ulkoinen ajuri
   palauttaa nykyisen sijainnin ulkoisella kortilla muodossa <term>FEN</term>, joka
   Verrataan sitten scidCommunityn sisäiseen esitykseen. Erot
   ilmestyy konsoliin ja antaa hälytyksen.
   </p>
   <p>
   Jos scidCommunity ja ulkoinen kortti eivät synkronoidu,
   <term> Synkronoi </term> -painiketta voidaan käyttää. Uusi peli on asetettu
   ja aloitusasento on asetettu ulkoisen asentoon
   hallitus.  </p>
   <p>
   <term>Close</term> -painike katkaisee lopulta ulkoisen yhteyden
   laitteisto ja sulkee konsolin.
   </p>

   <h2>Erikoisominaisuudet </h2>
   <p>
   Seuraavat ominaisuudet riippuvat kuljettajan moottorista ja laitteistosta
   jota käytetään. Niiden kuvaus perustuu käytettävissä oleviin toimintoihin
   <url http://www.dgt-projects.com>DGT elektronisen shakin kanssa
   Board </url> ja määritelty
   <url http://dgtdrv.sourceforge.net> Input Engine Protocol </url>
   kuvaus. Jotkut näistä toiminnoista perustuvat kuitenkin siihen tosiasiaan
   laitteisto pystyy tunnistamaan laudalla olevat palat ja niiden
   nykyinen sijoitus.
   </p>

   <h3> Aseman määritys </h3>
   <p>
   Paikan asetustila avataan poistamalla molemmat kuninkaat
   hallitus. Tässä tilassa <term>siirtoalue</term> on keltainen
   ja näyttää valkoisen kuninkaan ja merkkijonon <b>Setup</b>.
   </p>
   <p>
   Asetustilassa ulkoiselle laitteelle voidaan asettaa mikä tahansa kelvollinen sijainti
   hallitus, mutta scidCommunityn sisäistä edustusta ei päivitetä ennen kuin
   valmis.
   </p>
   <p>
   Asetustilan lopettamiseksi molemmat kuninkaat asetetaan takaisin pelilaudalle. Huomaa,
   että siirrettävän puolen kuningas asettuu taaksepäin <b>viimeinen</b>, eli
   jos valkoisen pitäisi olla liikkeellä, käännä ensin musta kuningas takaisin
   valkoinen kuningas. Nyt <term>siirtoalueella </term> näkyy musta
   Kuningatar ja merkkijono <b>OK</b>.
   </p>

   <h3> Lopeta peli </h3>
   <p>
   Pelin syötössä tai pelissä voi lopettaa nykyisen pelin asettamalla
   molemmat kuninkaat laudan keskiruutuihin. Tulos on
   annetaan seuraavasti:
   </p>
   <ul>
      <li><term>1-0</term> (Valkoinen voitto): Aseta molemmat kuninkaat ruutuihin
      e4 ja d5 missä tahansa järjestyksessä, esim. valkoisiin keskiruutuihin.
      Liikkumisalue on väritetty valkoisella, ja siinä näkyy valkoinen kuningas ja
      tulos.
      </li>
      <li><term>0-1</term> (Musta voitto): Aseta molemmat kuninkaat ruutuihin
      e5 ja d4 missä tahansa järjestyksessä, esim. mustiin keskiruutuihin.
      Liikkumisalue on väritetty harmaalla, ja siinä näkyy musta kuningas ja
      tulos.
      </li>
      <li><term>1/2-1/2</term> (Arvonta): Aseta yksi kuningas valkoiselle ja yksi
      mustalla keskiruudulla missä tahansa järjestyksessä.
      Siirtoalue on väritetty mustavalkoiseksi ja näyttää tuloksen.
      </li>
   </ul>
   <p>
   Kummassakin tapauksessa <term>Tallenna / Lisää peli </term> -valintaikkuna tulee näkyviin
   mahdollistaa pelin tunnisteiden täyttämisen ja pelin tallentamisen
   nykyinen tietokanta.
   </p>

   <h3> Aloita uusi peli </h3>
   <p>
   Uutta peliä voi tuijottaa siirtymällä asetustilaan (eli poistamalla molemmat
   kuninkaat) ja aloitusasennon asettaminen. Ilmoittaa, että scidCommunity on
   tunnisti kutsun uudelle pelille <term>siirtoalue</term>.
   väritetty sinisellä, jossa näkyy valkoinen kuningas ja naru
   <term>OK</term>.
   </p>


  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,ReviewGame) "Pelin arvostelu"
set helpText(U,ReviewGame) {<h1> Pelin arvosteleminen </h1>
   <p>
	Tämä ominaisuus on suunniteltu pelin tutkimiseen, mikä tarkoittaa, että sinun pitäisi
	yritä arvata ottelun aikana pelatut liikkeet. Joten avaat ensin a
	peli mistä tahansa scidCommunityn tukikohdasta ja syötä tämä toiminto komennolla
	<b>Tarkista peli </b> <b>Play</b> -valikossa.  Kuten yleensä, pelaamaan
	Mustalla, käännä lauta ensin (pelaat aina alareunasta
	lauta).
   </p>
	<p>
	Tehokas harjoittelu edellyttää seuraavia asetuksia
	pois käytöstä:
	<ul>
		<li>Näytä viimeinen liike (Asetukset / Liikkeet / Korosta viimeinen liike) </li>
		<li>Näytä seuraava siirto (Asetukset / Pelitiedot / Piilota seuraava siirto)</li>
		<li>PGN-ikkuna </li>
	</p>
Prosessi on seuraava:
<ul>
<li> - moottorit pohtivat pelin aikana pelattua liikettä </li>
<li> - moottori pohtii sijaintia ja löytää parhaan liikkeen </li>
<li> - käyttäjä saa sitten tehdä siirtonsa </li>
<li> - moottori pohtii käyttäjän pelaamaa liikkeellä </li>
</ul>
Jos käyttäjän tekemä siirto on joko todellisuudessa pelattu siirto
pelin aikana tai moottorin valitseman liikkeen tai liikkeen, jonka tulos on
on lähellä parasta moottorin löytämää liikettä (käyttäen marginaalivirhettä
käyttäjän määrittelemä), siirtoa pidetään hyvänä. Jos
käyttäjä on eri mieltä moottorin kanssa, hän voi käyttää <b>pidennettyä aikaa </b>
-painiketta saadaksesi vahvistuksen moottorin analyysistä.
<p>
<b>Huomioitavaa:</b> 
<ul>
<li>- Puoli on valittava ennen pelin tarkistamista </li>
<li> - Käyttäjä pelaa aina laudan alaosasta </li>
</ul>
</p>
  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}


set helpTitle(U,Metadata) "Dublin Coren metatiedot"
set helpText(U,Metadata) {<h1>Dublin Core Metadata </h1>
   <p>
   <url "http://dublincore.org">Dublin Core</a>-metatietoelementti
   määrittelee standardoidun ja laajalti käytetyn tavan vaihtaa
   tiedot sähköisistä resursseista (metadata eli tiedot ko
   tiedot). Dublin Core määriteltiin vuonna 2003 ISO-standardin 15836 mukaan
   NISO-standardi Z39.85-2007.
   </p>
   <p>
   Jotkut scidCommunityn kanssa käytetyt tietokannat voivat sisältää muita
   metatietotiedot. Tällaiset tiedot voivat viitata lisenssiin
   tietokanta, tietokannan lähde (jos se on julkaistu
   Web), tietokannan päivämäärä ja niin edelleen.
   </p>
   <p>
   Näitä tietoja voi tarkastella tai liittää tietokantaan
   valitsemalla <term>Tietokannan tiedot </term>. Uusi ikkuna avautuu
   joka näyttää yksittäiset Dublin Core -kohteet ja sallii muokkauksen
   niitä.
   </p>
   <p>
   Sisäisesti metatiedot tallennetaan <term>sme</term> -tiedostoihin, jotka voivat
   mukana tietokanta. Jos <term>sme</term> -tiedostoa ei ole olemassa
   <term>Tietokannan tiedot </term> -valintaikkunan avaaminen asettuu
   oletusarvot, jotka perustuvat nykyiseen tietokantaan. Tämä on merkitty
   tarrat näkyvät <blue> sinisenä </blue>.
   </p>
   <p>
   Kun olet valinnut <term>OK</term>, scidCommunity tallentaa metatiedot
   <term>sme</term> -tiedosto käytettäväksi scidCommunityn kanssa. Lisäksi an

   <term>XML</term> -tiedosto luodaan, joka sisältää täsmälleen saman
   metatiedot, mutta XML-muodossa tiedonvaihdon helpottamiseksi.
   </p>
   <p>
   <b>Huomaa</b>: scidCommunity ei välitä itse XML-tiedostosta. Se käyttää
   vain <term>sme</term> -tiedosto sisäisiä menettelyjä varten.
   Muut sovellukset voivat kuitenkin suosia XML-rakennetta.
   </p>

  <p><footer>(Päivitetty: scidCommunity, huhtikuu 2026)</footer></p>
}

