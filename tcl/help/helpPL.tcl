  <li>  <b>B4</b>  1.e4 c5 2.Nf3 e6: <i>Sycylijska</i> </li>
  <li>  <b>B5</b>  1.e4 c5 2.Nf3 d6: <i>Sycylijska</i> </li>
  <li>  <b>B6</b>  B5 + 3.d4 cxd4 4.Nxd4 Nf6 5.Nc3 Nc6 </li>
  <li>  <b>B7</b>  B5 + 4.Nxd4 Nf6 5.Nc3 g6: <i>Sycylijska Smocza</i> </li>
  <li>  <b>B8</b>  B5 + 4.Nxd4 Nf6 5.Nc3 e6: <i>Sycylijska Scheveningen</i> </li>
  <li>  <b>B9</b>  B5 + 4.Nxd4 Nf6 5.Nc3 a6: <i>Sycylijska Najdorfa</i> </li>
  </ul>
  
  <p>
  <b><blue><run ::windows::eco::Refresh C>C</run></blue></b>
  1.e4 e5;  1.e4 e6
  <ul>
  <li>  <b>C0</b>  1.e4 e6: <i>Obrona Francuska</i> </li>
  <li>  <b>C1</b>  1.e4 e6 2.d4 d5 3.Nc3: <i>Francuska, Winawer/Klasyczna</i> </li>
  <li>  <b>C2</b>  1.e4 e5: <i>Gra Otwarta</i> </li>
  <li>  <b>C3</b>  1.e4 e5 2.f4: <i>Gambit Królewski</i> </li>
  <li>  <b>C4</b>  1.e4 e5 2.Nf3: <i>Gra Otwarta</i> </li>
  <li>  <b>C5</b>  1.e4 e5 2.Nf3 Nc6 3.Bc4: <i>Włoska; Dwóch Skoczków</i> </li>
  <li>  <b>C6</b>  1.e4 e5 2.Nf3 Nc6 3.Bb5: <i>Hiszpańska (Ruy Lopez)</i> </li>
  <li>  <b>C7</b>  1.e4 e5 2.Nf3 Nc6 3.Bb5 a6 4.Ba4: <i>Hiszpańska</i> </li>
  <li>  <b>C8</b>  C7 + 4...Nf6 5.O-O: <i>Hiszpańska, Zamknięta i Otwarta</i>
  (<b>C80-C83</b>  5.O-O Nxe4: <i>Hiszpańska, System Otwarty</i>;
  <b>C84-C89</b>  5.O-O Be7: <i>Hiszpańska, System Zamknięty</i>) </li>
  <li>  <b>C9</b>  C8 + 5...Be7 6.Re1 b5 7.Bb3 d6: <i>Hiszpańska, Zamknięta</i> </li>
  </ul>
  
  <p>
