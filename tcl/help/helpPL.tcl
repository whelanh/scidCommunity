  <ul>
  <li>  <b>B0</b>  1.e4 ...
  (<b>B02-B05</b>  1.e4 Nf6: <i>Obrona Alechina</i>;
  <b>B07-B09</b>  1.e4 d6: <i>Obrona Pirca</i>) </li>
