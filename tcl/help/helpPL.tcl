  <li>  <b>E3</b>  E2 + 4.Bg5 lub 4.Qc2: <i>Nimzoindyjska</i> </li>
  <li>  <b>E4</b>  E2 + 4.e3: <i>Nimzoindyjska, Rubinstein</i> </li>
  <li>  <b>E5</b>  E4 + 4...O-O 5.Nf3: <i>Nimzoindyjska, linia główna</i> </li>
  <li>  <b>E6</b>  1.d4 Nf6 2.c4 g6: <i>Indyjska Królewska</i> </li>
  <li>  <b>E7</b>  1.d4 Nf6 2.c4 g6 3.Nc3 Bg7 4.e4: <i>Indyjska Królewska</i> </li>
  <li>  <b>E8</b>  E7 + 4...d6 5.f3: <i>Indyjska Królewska, Sämisch</i> </li>
  <li>  <b>E9</b>  E7 + 4...d6 5.Nf3: <i>Indyjska Królewska, linie główne</i> </li>
  </ul>
  
  <p><footer>(Zaktualizowano: ScidCommunity, kwiecień 2026)</footer></p>
}


